# MongoDB connection used by the document and vector collections.
MONGODB_URI=

# Optional: enables answer generation with Gemini through its OpenAI-compatible API.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: enables the Jina API reranker when used by the application.
JINA_API_KEY=

# Set to 1 to use the Gemini-based reranker instead of the local fallback.
RERANK_WITH_LLM=0

# Optional: enable EasyOCR for scanned/image-only PDFs. Keep 0 for text PDFs.
RAG_ENABLE_OCR=0
